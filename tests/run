#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

grep -Fqx -- '  "id": "omayap.read-aloud",' "$ROOT/manifest.json"
grep -Fqx -- '  "name": "OmaYap",' "$ROOT/manifest.json"
grep -Fqx -- '    "displayName": "OmaYap",' "$ROOT/manifest.json"
grep -Fqx -- '# OmaYap' "$ROOT/README.md"
grep -Fq -- '`OmaYap` is an Omarchy shell plugin' "$ROOT/README.md"
grep -Fq -- 'https://github.com/Ray-4Ws/OmaYap' "$ROOT/README.md"
grep -Fqx -- '  "version": "1.4.0",' "$ROOT/manifest.json"
grep -Fqx -- '  readonly property string pluginVersion: "1.4.0"' "$ROOT/Service.qml"
grep -Fqx -- 'PLUGIN_VERSION="1.4.0"' "$ROOT/bin/setup"
! rg -n -F 'Read aloud setup required' "$ROOT/Service.qml" "$ROOT/BarWidget.qml"
! rg -n -F 'Read aloud error' "$ROOT/Service.qml" "$ROOT/BarWidget.qml"
grep -Fq -- 'property bool stopPending: false' "$ROOT/Service.qml"
grep -Fq -- 'status === "stopping"' "$ROOT/Service.qml"
[[ "$(grep -Fc -- 'if (root.stopPending) return' "$ROOT/Service.qml")" -eq 2 ]]
grep -Fq -- 'root.state === "stopping" ? "Stopping OmaYap"' "$ROOT/BarWidget.qml"
grep -Fq -- 'step: 0.25' "$ROOT/BarWidget.qml"
grep -Fq -- 'tickCount: 7' "$ROOT/BarWidget.qml"
grep -Fq -- 'readonly property var speedPresets: [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0]' "$ROOT/BarWidget.qml"
grep -Fq -- 'text: root.formatSpeed(modelData)' "$ROOT/BarWidget.qml"
grep -Fq -- 'onClicked: root.setPresetSpeed(modelData)' "$ROOT/BarWidget.qml"
grep -Fq -- 'selected: root.presetSelected(modelData)' "$ROOT/BarWidget.qml"
grep -Fq -- 'function snapSpeed(value)' "$ROOT/BarWidget.qml"
grep -Fq -- 'speedSlider.liveValue = root.snapSpeed(value)' "$ROOT/BarWidget.qml"
grep -Fq -- 'function commitSpeed()' "$ROOT/BarWidget.qml"
grep -Fq -- 'TextField {' "$ROOT/BarWidget.qml"
grep -Fq -- 'grabFocus: root.popupOpen' "$ROOT/BarWidget.qml"
grep -Fq -- 'activeFocusOnPress: true' "$ROOT/BarWidget.qml"
grep -Fq -- 'speedValue.forceActiveFocus()' "$ROOT/BarWidget.qml"
grep -Fq -- 'placeholderText: "1.10"' "$ROOT/BarWidget.qml"
grep -Fq -- 'text: "Custom"' "$ROOT/BarWidget.qml"
grep -Fq -- 'share/bounded_capture.py' "$ROOT/Service.qml"
grep -Fq -- 'readonly property int selectionByteCap: 80004' "$ROOT/Service.qml"
grep -Fq -- 'readonly property int clipboardByteCap: 1048576' "$ROOT/Service.qml"
grep -Fq -- 'function codePointCount(value)' "$ROOT/Service.qml"
grep -Fq -- 'if (actual > root.maxCharacters)' "$ROOT/Service.qml"
grep -Fq -- 'var low = text.charCodeAt(index + 1)' "$ROOT/Service.qml"
! grep -Fq -- 'root.rejectCapturedText(20001)' "$ROOT/Service.qml"
grep -Fq -- 'Selection exceeds the 20,000-character maximum. No text was read.' "$ROOT/Service.qml"
[[ "$(grep -Fc -- 'root.boundedCommand(root.mimeByteCap' "$ROOT/Service.qml")" -eq 2 ]]
[[ "$(grep -Fc -- 'root.boundedCommand(root.selectionByteCap' "$ROOT/Service.qml")" -ge 2 ]]
grep -Fq -- 'root.boundedCommand(root.clipboardByteCap' "$ROOT/Service.qml"
grep -Fq -- 'root.boundedCommand(root.activeWindowByteCap' "$ROOT/Service.qml"
grep -Fq -- 'settingsReadProc.command = ["head", "-c", "4097"' "$ROOT/Service.qml"
grep -Fq -- 'onExited: function(exitCode)' "$ROOT/Service.qml"
grep -Fq -- 'root.primaryTextExitCode = exitCode' "$ROOT/Service.qml"
grep -Fq -- 'root.clipboardTextExitCode = exitCode' "$ROOT/Service.qml"
grep -Fq -- 'root.pollExitCode = exitCode' "$ROOT/Service.qml"
grep -Fq -- 'omarchy restart shell' "$ROOT/README.md"
! grep -Fq -- 'process.wait()' "$ROOT/share/bounded_capture.py"
grep -Fq -- 'readonly property int workerIdleTimeoutMs: 60000' "$ROOT/Service.qml"
grep -Fq -- 'property bool expectedWorkerExit: false' "$ROOT/Service.qml"
grep -Fq -- 'function armIdleEviction()' "$ROOT/Service.qml"
grep -Fq -- 'function evictIdleWorker()' "$ROOT/Service.qml"
grep -Fq -- 'workerIdleTimer.restart()' "$ROOT/Service.qml"
grep -Fq -- 'workerEvictionKillTimer.restart()' "$ROOT/Service.qml"
grep -Fq -- 'if (root.expectedWorkerExit && workerProc.running) workerProc.running = false' "$ROOT/Service.qml"
grep -Fq -- 'var queuedAfterEviction = root.pendingWorkerCommands' "$ROOT/Service.qml"
grep -Fq -- 'root.captureStage !== "idle"' "$ROOT/Service.qml"
grep -Fq -- 'if (workerProc.running && !root.expectedWorkerExit)' "$ROOT/Service.qml"
grep -Fq -- 'enable_cpu_mem_arena = False' "$ROOT/worker/worker.py"
grep -Fq -- 'enable_mem_pattern = False' "$ROOT/worker/worker.py"
grep -Fq -- '"--legacy-defaults"' "$ROOT/worker/worker.py"
grep -Fq -- '"--discard-audio"' "$ROOT/worker/worker.py"
grep -Fq -- 'DEFAULT_CHUNK_TARGETS = (200, 400, 800)' "$ROOT/benchmarks/memory.py"
grep -Fq -- 'parse_smaps_rollup' "$ROOT/benchmarks/memory.py"
grep -Fq -- 'PROTOCOL_VERSION = 1' "$ROOT/worker/worker.py"
grep -Fq -- 'command in {"speak", "read-selection"}' "$ROOT/worker/worker.py"
grep -Fq -- 'unsupported-protocol-version' "$ROOT/worker/worker.py"
grep -Fq -- 'invalid-request-id' "$ROOT/worker/worker.py"
grep -Fq -- 'CLEANUP_PROFILES = ("off", "safe", "article")' "$ROOT/worker/worker.py"
grep -Fq -- 'DEFAULT_CLEANUP_PROFILE = "safe"' "$ROOT/worker/worker.py"
grep -Fq -- 'cleanupProfile' "$ROOT/worker/worker.py"
grep -Fq -- 'invalid-cleanup-profile' "$ROOT/worker/worker.py"
grep -Fq -- 'readonly property int workerProtocolVersion: 1' "$ROOT/Service.qml"
grep -Fq -- 'command: "speak"' "$ROOT/Service.qml"
grep -Fq -- 'property string cleanupProfile: "safe"' "$ROOT/Service.qml"
grep -Fq -- 'cleanupProfiles: ["off", "safe", "article"]' "$ROOT/BarWidget.qml"
grep -Fq -- 'function setCleanupProfile(value)' "$ROOT/BarWidget.qml"
grep -Fq -- 'protocolCommand(command)' "$ROOT/Service.qml"
grep -Fq -- 'validWorkerEvent(parsed)' "$ROOT/Service.qml"
test -x "$ROOT/bin/manage-voices"
test -f "$ROOT/share/voices.json"
grep -Fq -- 'schemaVersion' "$ROOT/share/voices.json"
grep -Fq -- 'cardDownloadUrl' "$ROOT/share/voices.json"
grep -Fq -- 'function requestVoiceList()' "$ROOT/Service.qml"
grep -Fq -- 'function installVoice(id)' "$ROOT/Service.qml"
grep -Fq -- 'function selectVoice(id)' "$ROOT/Service.qml"
grep -Fq -- 'function finishCancelledVoiceManager()' "$ROOT/Service.qml"
grep -Fq -- 'voiceManagerCancelPending' "$ROOT/Service.qml"
grep -Fq -- 'readonly property bool voiceActionsBusy' "$ROOT/Service.qml"
grep -Fq -- 'var failedCode = "manager-failed"' "$ROOT/Service.qml"
! sed -n '/readonly property bool active:/p' "$ROOT/Service.qml" | grep -Fq -- 'expectedWorkerExit'
grep -Fq -- 'text: modelData.selected ? "Selected"' "$ROOT/BarWidget.qml"
grep -Fq -- 'voiceSizeLabel(modelData.sizeBytes)' "$ROOT/BarWidget.qml"
test -f "$ROOT/docs/backend-protocol.md"
grep -Fq -- 'backend protocol v1' "$ROOT/docs/backend-protocol.md"
grep -Fq -- 'cleanupProfile' "$ROOT/docs/backend-protocol.md"
grep -Fq -- 'DEFAULT_REPEAT_CYCLES = 10' "$ROOT/benchmarks/memory.py"
grep -Fq -- 'choices=("none", "serial", "interrupt")' "$ROOT/benchmarks/memory.py"
grep -Fq -- 'completion_event = "replacement-idle"' "$ROOT/benchmarks/memory.py"
grep -Fq -- 'render_repeat' "$ROOT/benchmarks/memory.py"
grep -Fq -- '--repeat-mode serial' "$ROOT/README.md"
grep -Fq -- '--repeat-mode interrupt' "$ROOT/README.md"
grep -Fq -- 'stop_idle_events' "$ROOT/README.md"
grep -Fq -- 'bin/capture-ocr' "$ROOT/Service.qml"
grep -Fq -- 'function readOcr()' "$ROOT/Service.qml"
grep -Fq -- 'function speakRequest(token)' "$ROOT/Service.qml"
grep -Fq -- 'read-yap-fifo' "$ROOT/Service.qml"
grep -Fq -- 'id: ocrProc' "$ROOT/Service.qml"
grep -Fq -- 'id: bridgeProc' "$ROOT/Service.qml"
grep -Fq -- 'function finishCancelledOcr()' "$ROOT/Service.qml"
grep -Fq -- 'function finishCancelledBridge()' "$ROOT/Service.qml"
! rg -n -F '"cat"' "$ROOT/Service.qml"
grep -Fq -- 'readOcr' "$ROOT/BarWidget.qml"
grep -Fq -- 'Ctrl+F10' "$ROOT/BarWidget.qml"
grep -Fq -- 'CTRL + F10' "$ROOT/bin/setup"
grep -Fq -- 'modmask' "$ROOT/bin/setup"
grep -Fq -- 'F10 and CTRL+F10' "$ROOT/bin/uninstall"
test -x "$ROOT/bin/capture-ocr"
test -x "$ROOT/bin/yap"
test -x "$ROOT/bin/read-yap-fifo"
test -x "$ROOT/bin/install-codex-skill"
test -x "$ROOT/bin/ocr-shims/wl-copy"
test -x "$ROOT/bin/ocr-shims/omarchy-notification-send"
test -f "$ROOT/extras/codex-skill/omayap-yaps/SKILL.md"
grep -Fq -- 'XDG_RUNTIME_DIR' "$ROOT/bin/yap"
grep -Fq -- 'speakRequest' "$ROOT/bin/yap"
grep -Fq -- 'OMARCHY_OCR_LANGS' "$ROOT/bin/capture-ocr"
grep -Fq -- 'native command' "$ROOT/bin/capture-ocr"
grep -Fq -- 'OCR' "$ROOT/README.md"
grep -Fq -- 'CLIPBOARD' "$ROOT/README.md"
grep -Fq -- 'OMARCHY_OCR_LANGS' "$ROOT/README.md"
grep -Fq -- 'install-codex-skill' "$ROOT/README.md"
grep -Fq -- 'adapters outside this transport' "$ROOT/docs/backend-protocol.md"
grep -Fq -- 'regular file' "$ROOT/docs/backend-protocol.md"
grep -Fq -- 'docs/native-backend-decision.md' "$ROOT/README.md"
grep -Fq -- 'docs/memory-benchmark-results.md' "$ROOT/README.md"

python3 -m unittest -v tests.test_worker
python3 -m unittest -v tests.test_integrations
python3 -m unittest -v tests.test_voice_manager

if command -v omarchy >/dev/null 2>&1; then
  (cd "$ROOT" && omarchy plugin validate .)
fi
if command -v qmllint >/dev/null 2>&1 && [[ -d /usr/share/omarchy/shell ]]; then
  (cd "$ROOT" && qmllint -I /usr/share/omarchy/shell Service.qml BarWidget.qml)
fi
if rg -n -F 'root.pollTimer' "$ROOT/Service.qml"; then
  echo "Service.qml must access the lexical pollTimer id directly" >&2
  exit 1
fi

tmp="$(mktemp -d "${TMPDIR:-/tmp}/omayap-read-aloud-tests.XXXXXX")"
trap 'rm -rf -- "$tmp"' EXIT
fakebin="$tmp/bin"
home="$tmp/home"
config="$tmp/config"
data="$tmp/data"
mkdir -p -- "$fakebin" "$home" "$config/hypr" "$data"

cat >"$fakebin/uv" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat >"$fakebin/omarchy-shell" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat >"$fakebin/omarchy" <<'EOF'
#!/usr/bin/env bash
if [[ "$*" == "menu keybindings --print" && -n "${FAKE_EFFECTIVE:-}" && -f "$FAKE_EFFECTIVE" ]]; then
  cat "$FAKE_EFFECTIVE"
fi
exit 0
EOF
cat >"$fakebin/hyprctl" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  binds)
    [[ -n "${FAKE_BINDS:-}" && -f "$FAKE_BINDS" ]] && cat "$FAKE_BINDS"
    ;;
  configerrors)
    if [[ "${FAKE_HYPR_FAIL:-0}" == 1 ]]; then echo "Error: fake config error"; else echo "No errors"; fi
    ;;
  reload) exit "${FAKE_RELOAD_CODE:-0}" ;;
esac
exit 0
EOF
chmod 700 -- "$fakebin"/*

export HOME="$home"
export XDG_CONFIG_HOME="$config"
export XDG_DATA_HOME="$data"
export PATH="$fakebin:$PATH"
export FAKE_EFFECTIVE="$tmp/effective"
export FAKE_BINDS="$tmp/binds"
: >"$FAKE_EFFECTIVE"
: >"$FAKE_BINDS"

run_setup() {
  OMAYAP_TEST_MODE=1 OMAYAP_TEST_PYTHON="$(command -v python3)" \
    "$ROOT/bin/setup" >/dev/null
}

printf '%s\n' 'F10 Read selected text aloud' >"$FAKE_EFFECTIVE"
if run_setup >/dev/null 2>&1; then
  echo "setup incorrectly trusted an unmanaged F10 description" >&2
  exit 1
fi
: >"$FAKE_EFFECTIVE"

printf '%s\n' 'CTRL + F10 Foreign OCR action' >"$FAKE_EFFECTIVE"
if run_setup >/dev/null 2>&1; then
  echo "setup incorrectly trusted an unmanaged CTRL+F10 description" >&2
  exit 1
fi
: >"$FAKE_EFFECTIVE"

printf '%s\n' 'SUPER + CTRL + F10 Foreign combined action' >"$FAKE_EFFECTIVE"
if ! run_setup >/dev/null 2>&1; then
  echo "setup incorrectly treated SUPER+CTRL+F10 as CTRL+F10" >&2
  exit 1
fi
rm -f -- "$config/hypr/bindings.lua"
: >"$FAKE_EFFECTIVE"

printf '%s\n' 'CTRL + SHIFT + F10 Foreign combined action' >"$FAKE_EFFECTIVE"
if ! run_setup >/dev/null 2>&1; then
  echo "setup incorrectly treated CTRL+SHIFT+F10 as CTRL+F10" >&2
  exit 1
fi
rm -f -- "$config/hypr/bindings.lua"
: >"$FAKE_EFFECTIVE"

cat >"$config/hypr/bindings.lua" <<'EOF'
-- BEGIN OMAYAP_READ_ALOUD_F10
o.bind("F10", "Read selected text aloud", "omarchy-shell omayap.read-aloud toggleSelection")
-- END OMAYAP_READ_ALOUD_F10
EOF
printf '%s\n' 'CTRL + F10 Read screen text aloud (OCR)' >"$FAKE_EFFECTIVE"
if run_setup >/dev/null 2>&1; then
  echo "setup trusted a lossy CTRL+F10 description from an old partial block" >&2
  exit 1
fi
rm -f -- "$config/hypr/bindings.lua"
: >"$FAKE_EFFECTIVE"

printf '%s\n' '[{"key":"F10","dispatcher":"exec","arg":"omarchy-shell omayap.read-aloud toggleSelection","description":"Read selected text aloud"}]' >"$FAKE_BINDS"
if run_setup >/dev/null 2>&1; then
  echo "setup trusted an unmanaged exact-command F10 JSON binding" >&2
  exit 1
fi
: >"$FAKE_BINDS"

printf '%s\n' '[{"key":"F10","modmask":4,"dispatcher":"exec","arg":"foreign-action","description":"Foreign CTRL+F10 action"}]' >"$FAKE_BINDS"
if run_setup >/dev/null 2>&1; then
  echo "setup missed a foreign CTRL+F10 binding in hyprctl JSON" >&2
  exit 1
fi
: >"$FAKE_BINDS"

printf '%s\n' 'o.bind("F10", "Read selected text aloud", "omarchy-shell omayap.read-aloud toggleSelection")' >"$config/hypr/bindings.lua"
if run_setup >/dev/null 2>&1; then
  echo "setup trusted an unmanaged exact-command user binding" >&2
  exit 1
fi
rm -f -- "$config/hypr/bindings.lua"

printf '%s\n' 'o.bind("CTRL + F10", "Foreign OCR action", "foreign-action")' >"$config/hypr/bindings.lua"
if run_setup >/dev/null 2>&1; then
  echo "setup trusted an unmanaged CTRL+F10 Lua binding" >&2
  exit 1
fi
rm -f -- "$config/hypr/bindings.lua"

run_setup
grep -Fqx -- '-- BEGIN OMAYAP_READ_ALOUD_F10' "$config/hypr/bindings.lua"
grep -Fqx -- '-- END OMAYAP_READ_ALOUD_F10' "$config/hypr/bindings.lua"
[[ "$(grep -Fc 'omayap.read-aloud toggleSelection' "$config/hypr/bindings.lua")" == 1 ]]
[[ "$(grep -Fc 'omayap.read-aloud readOcr' "$config/hypr/bindings.lua")" == 1 ]]
grep -Fqx -- 'o.bind("CTRL + F10", "Read screen text aloud (OCR)", "omarchy-shell omayap.read-aloud readOcr")' "$config/hypr/bindings.lua"
[[ -f "$data/omayap-read-aloud/runtime-version" ]]
[[ -f "$data/omayap-read-aloud/models/en_US-lessac-medium.MODEL_CARD" ]]
[[ -f "$data/omayap-read-aloud/selected-voice" ]]
if find "$data/omayap-read-aloud/models" -maxdepth 1 -type f -name 'en_US-kristin-medium*' -print -quit | grep -q .; then exit 1; fi
if find "$data/omayap-read-aloud/models" -maxdepth 1 -type f -name 'en_US-john-medium*' -print -quit | grep -q .; then exit 1; fi
if find "$data/omayap-read-aloud/models" -maxdepth 1 -type f -name 'en_GB-alba-medium*' -print -quit | grep -q .; then exit 1; fi
rg -Fq 'PLUGIN_VERSION=$5' "$ROOT/Service.qml"

OMAYAP_TEST_MODE=1 OMAYAP_TEST_SOURCE_DIR="$data/omayap-read-aloud/test-fixtures" \
  python3 "$ROOT/bin/manage-voices" install en_US-kristin-medium >/dev/null
OMAYAP_TEST_MODE=1 OMAYAP_TEST_SOURCE_DIR="$data/omayap-read-aloud/test-fixtures" \
  python3 "$ROOT/bin/manage-voices" select en_US-kristin-medium >/dev/null
run_setup
grep -Fqx -- 'en_US-kristin-medium' "$data/omayap-read-aloud/selected-voice"
[[ -f "$data/omayap-read-aloud/models/en_US-kristin-medium.onnx" ]]

printf '%s\n' 'F10 Read selected text aloud' >"$FAKE_EFFECTIVE"
printf '%s\n' '[{"key":"F10","dispatcher":"__lua","arg":"270","description":"Read selected text aloud"}]' >"$FAKE_BINDS"
first_binding_hash="$(sha256sum "$config/hypr/bindings.lua" | cut -d' ' -f1)"
run_setup
[[ "$(grep -Fc 'omayap.read-aloud toggleSelection' "$config/hypr/bindings.lua")" == 1 ]]
second_binding_hash="$(sha256sum "$config/hypr/bindings.lua" | cut -d' ' -f1)"
[[ "$first_binding_hash" == "$second_binding_hash" ]]

printf '%s\n' 'F10 Read selected text aloud' 'CTRL + F10 Read screen text aloud (OCR)' >"$FAKE_EFFECTIVE"
printf '%s\n' '[{"key":"F10","modmask":0,"dispatcher":"__lua","arg":"270","description":"Read selected text aloud"},{"key":"F10","modmask":4,"dispatcher":"__lua","arg":"271","description":"Read screen text aloud (OCR)"}]' >"$FAKE_BINDS"
run_setup

printf '%s\n' '[{"key":"F10","dispatcher":"__lua","arg":"270","description":"Read selected text aloud"},{"key":"F10","dispatcher":"exec","arg":"foreign-action","description":"Foreign F10 action"}]' >"$FAKE_BINDS"
if run_setup >/dev/null 2>&1; then
  echo "setup missed a foreign F10 binding in mixed hyprctl JSON" >&2
  exit 1
fi
: >"$FAKE_BINDS"

printf '%s\n' '[{"key":"F10","dispatcher":"__lua","arg":"270","description":"Read selected text aloud"},{"key":"F10","dispatcher":"__lua","arg":"271","description":"Read selected text aloud"}]' >"$FAKE_BINDS"
if run_setup >/dev/null 2>&1; then
  echo "setup accepted duplicate opaque F10 bindings" >&2
  exit 1
fi
: >"$FAKE_BINDS"

printf '%s\n' 'F10 Existing action' >"$FAKE_EFFECTIVE"
if run_setup >/dev/null 2>&1; then
  echo "setup unexpectedly overrode a foreign F10 binding" >&2
  exit 1
fi
: >"$FAKE_EFFECTIVE"

before="$(sha256sum "$config/hypr/bindings.lua" | cut -d' ' -f1)"
if FAKE_HYPR_FAIL=1 run_setup >/dev/null 2>&1; then
  echo "setup unexpectedly accepted a fake Hyprland error" >&2
  exit 1
fi
after="$(sha256sum "$config/hypr/bindings.lua" | cut -d' ' -f1)"
[[ "$before" == "$after" ]]

"$ROOT/bin/uninstall"
! grep -Fq 'omayap.read-aloud toggleSelection' "$config/hypr/bindings.lua"
[[ -f "$data/omayap-read-aloud/runtime-version" ]]

mkdir -p -- "$config/omayap-read-aloud" "$data/omayap-read-aloud" "$config/keep" "$data/keep"
: >"$config/keep/sentinel"
: >"$data/keep/sentinel"
OMAYAP_ASSUME_YES=1 "$ROOT/bin/uninstall" --purge
[[ ! -e "$config/omayap-read-aloud" && ! -e "$data/omayap-read-aloud" ]]
[[ -f "$config/keep/sentinel" && -f "$data/keep/sentinel" ]]

echo "all OmaYap tests passed"
