#!/usr/bin/env bash
# Install the local Piper runtime/model and add the managed F10/CTRL+F10 bindings.
#
# Omarchy plugin installation intentionally does not run hooks.  This command
# is therefore explicit and idempotent.  The OMAYAP_TEST_MODE branch is only
# used by the repository's fake-backed tests; it never runs in normal setup.
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
PLUGIN_VERSION="1.3.0"
VOICE="en_US-lessac-medium"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_ROOT="$DATA_HOME/omayap-read-aloud"
MODEL_DIR="$DATA_ROOT/models"
MODEL="$MODEL_DIR/$VOICE.onnx"
MODEL_JSON="$MODEL.json"
MODEL_CARD="$MODEL_DIR/MODEL_CARD"
VENV="$DATA_ROOT/venv"
STAMP="$DATA_ROOT/runtime-version"
LOCKFILE="$ROOT/share/requirements.lock"
BINDINGS="$CONFIG_HOME/hypr/bindings.lua"
BEGIN_MARKER="-- BEGIN OMAYAP_READ_ALOUD_F10"
END_MARKER="-- END OMAYAP_READ_ALOUD_F10"
OWN_F10_COMMAND="omarchy-shell omayap.read-aloud toggleSelection"
OWN_F10_DESCRIPTION="Read selected text aloud"
OWN_OCR_COMMAND="omarchy-shell omayap.read-aloud readOcr"
OWN_OCR_DESCRIPTION="Read screen text aloud (OCR)"

MODEL_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/$VOICE.onnx"
MODEL_JSON_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/$VOICE.onnx.json"
MODEL_CARD_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/MODEL_CARD"
MODEL_SHA256="5efe09e69902187827af646e1a6e9d269dee769f9877d17b16b1b46eeaaf019f"
MODEL_JSON_SHA256="efe19c417bed055f2d69908248c6ba650fa135bc868b0e6abb3da181dab690a0"
MODEL_CARD_SHA256="ce49eb457742208166d399a40cdec2c7fa9db77960930031564ab56f12882645"

die() {
  echo "OmaYap setup: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

ensure_private_dir() {
  local path="$1"
  [[ -e "$path" && ! -d "$path" ]] && die "path is not a directory: $path"
  [[ -L "$path" ]] && die "refusing symlink directory: $path"
  mkdir -p -- "$path"
  chmod 700 -- "$path"
}

contains_foreign_text_chord() {
  local source="$1" chord="$2" allow_ours="${3:-0}" allow_description="${4:-0}" line="" rc=0
  [[ -z "$source" ]] && return 1
  command -v python3 >/dev/null 2>&1 \
    || die "python3 is required to safely inspect keybinding output"

  # Effective-menu output and Lua are line-oriented but may spell modifiers
  # with different spacing. Classify the complete chord so CTRL+F10 cannot be
  # mistaken for plain F10 (and reject other modifiers as neither chord).
  if line="$(python3 -c '
import re
import sys

chord = sys.argv[1]
allow_ours = sys.argv[2] == "1"
allow_description = sys.argv[3] == "1"
own_f10_command, own_f10_description = sys.argv[4:6]
own_ocr_command, own_ocr_description = sys.argv[6:8]
ctrl = re.compile(r"(?<![A-Za-z0-9])CTRL\s*(?:\+\s*|\s+)F10(?![A-Za-z0-9])", re.I)
f10 = re.compile(r"(?<![A-Za-z0-9+])F10(?![A-Za-z0-9])", re.I)
modifier_prefix = re.compile(r"(?:(?:CTRL|SUPER|ALT|SHIFT|META)\s*(?:\+\s*|\s+))*$", re.I)
modifier_word = re.compile(r"CTRL|SUPER|ALT|SHIFT|META", re.I)

def matches(line):
    ctrl_match = ctrl.search(line)
    if ctrl_match:
        prefix = line[:ctrl_match.start()]
        modifier_match = modifier_prefix.search(prefix)
        modifiers = {item.upper() for item in modifier_word.findall(modifier_match.group(0))} if modifier_match else set()
        if chord == "ctrl-f10" and modifiers == {"CTRL"}:
            return True
    for match in f10.finditer(line):
        prefix = line[:match.start()]
        modifier_match = modifier_prefix.search(prefix)
        modifiers = {item.upper() for item in modifier_word.findall(modifier_match.group(0))} if modifier_match else set()
        if (chord == "ctrl-f10" and modifiers == {"CTRL"}) or (chord == "f10" and not modifiers):
            return True
    return False

seen = False
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line.strip() or re.match(r"^\s*--", line):
        continue
    if not matches(line):
        continue
    if chord == "f10":
        own_command, own_description = own_f10_command, own_f10_description
    else:
        own_command, own_description = own_ocr_command, own_ocr_description
    own = (allow_ours and own_command in line) or (allow_description and own_description in line)
    if own and not seen:
        seen = True
        continue
    print(line)
    raise SystemExit(0)
raise SystemExit(1)
' "$chord" "$allow_ours" "$allow_description" "$OWN_F10_COMMAND" "$OWN_F10_DESCRIPTION" "$OWN_OCR_COMMAND" "$OWN_OCR_DESCRIPTION" <<<"$source")"; then
    printf '%s\n' "$line"
    return 0
  else
    rc=$?
    ((rc == 1)) && return 1
    die "could not inspect keybinding output safely"
  fi
}

contains_foreign_json_chord() {
  local source="$1" chord="$2" allow_ours="${3:-0}" allow_opaque="${4:-0}" line="" rc=0
  [[ -z "${source//[[:space:]]/}" ]] && return 1
  command -v python3 >/dev/null 2>&1 \
    || die "python3 is required to safely inspect hyprctl binds -j output"

  # hyprctl emits one JSON array. Parse every object independently and match
  # exact modmask/key pairs: 0 is F10 and 4 is CTRL+F10.
  if line="$(python3 -c '
import json
import re
import sys

try:
    bindings = json.loads(sys.stdin.read())
except Exception:
    raise SystemExit(2)
if not isinstance(bindings, list):
    raise SystemExit(2)

chord = sys.argv[1]
allow_ours = sys.argv[2] == "1"
allow_opaque = sys.argv[3] == "1"
own_f10_command, own_f10_description = sys.argv[4:6]
own_ocr_command, own_ocr_description = sys.argv[6:8]
opaque_arg = re.compile(r"^[0-9]+$")
seen = False

def modmask(binding):
    value = binding.get("modmask", 0)
    if type(value) is int:
        return value
    if isinstance(value, str) and value.isdigit():
        return int(value)
    return None

for binding in bindings:
    if not isinstance(binding, dict) or str(binding.get("key", "")).upper() != "F10":
        continue
    expected = 4 if chord == "ctrl-f10" else 0
    if modmask(binding) != expected:
        continue
    own_command, own_description = (
        (own_ocr_command, own_ocr_description)
        if chord == "ctrl-f10"
        else (own_f10_command, own_f10_description)
    )
    argument = binding.get("arg", "")
    exact = allow_ours and isinstance(argument, str) and argument == own_command
    opaque = (
        allow_opaque
        and binding.get("dispatcher") == "__lua"
        and binding.get("description") == own_description
        and isinstance(argument, str)
        and opaque_arg.fullmatch(argument) is not None
    )
    if (exact or opaque) and not seen:
        seen = True
        continue
    print(json.dumps(binding, ensure_ascii=True, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)
raise SystemExit(1)
' "$chord" "$allow_ours" "$allow_opaque" "$OWN_F10_COMMAND" "$OWN_F10_DESCRIPTION" "$OWN_OCR_COMMAND" "$OWN_OCR_DESCRIPTION" <<<"$source")"; then
    printf '%s\n' "$line"
    return 0
  else
    rc=$?
    ((rc == 1)) && return 1
    die "could not parse hyprctl binds -j output safely"
  fi
}

managed_binding_present() {
  local chord="$1"
  [[ -f "$BINDINGS" && ! -L "$BINDINGS" ]] || return 1
  grep -Fqx -- "$BEGIN_MARKER" "$BINDINGS" \
    && grep -Fqx -- "$END_MARKER" "$BINDINGS" \
    && case "$chord" in
      f10) grep -Fq -- "$OWN_F10_COMMAND" "$BINDINGS" ;;
      ctrl-f10) grep -Fq -- "$OWN_OCR_COMMAND" "$BINDINGS" ;;
      *) return 1 ;;
    esac
}

check_binding_conflict() {
  local chord="$1" menu_effective="" hypr_effective="" user="" line="" allow_ours=0 allow_effective_description=0
  if command -v omarchy >/dev/null 2>&1; then
    menu_effective="$(omarchy menu keybindings --print 2>/dev/null || true)"
  fi
  if command -v hyprctl >/dev/null 2>&1; then
    hypr_effective="$(hyprctl binds -j 2>/dev/null || true)"
  fi
  if [[ -f "$BINDINGS" ]]; then
    user="$(sed '/^[[:space:]]*--/d' "$BINDINGS")"
  fi
  # Omarchy's effective keybinding printout can omit the original plugin
  # command and retain only our human description.  Allow that lossy form
  # only on a rerun where the tagged binding is already present; a first run
  # must still reject a foreign action that happens to use the same label.
  if managed_binding_present "$chord"; then
    allow_ours=1
    allow_effective_description=1
  fi
  if line="$(contains_foreign_text_chord "$menu_effective" "$chord" "$allow_ours" "$allow_effective_description")"; then
    die "$chord is already bound; refusing to override: $line"
  fi
  if line="$(contains_foreign_json_chord "$hypr_effective" "$chord" "$allow_ours" "$allow_effective_description")"; then
    die "$chord is already bound; refusing to override: $line"
  fi
  if line="$(contains_foreign_text_chord "$user" "$chord" "$allow_ours" 0)"; then
    die "$chord is already present in $BINDINGS; refusing to override: $line"
  fi
}

check_binding_conflicts() {
  check_binding_conflict "f10"
  check_binding_conflict "ctrl-f10"
}

download_verified() {
  local url="$1" target="$2" expected="$3" tmp=""
  if [[ -f "$target" ]]; then
    if printf '%s  %s\n' "$expected" "$target" | sha256sum -c - >/dev/null 2>&1; then
      chmod 600 -- "$target"
      return 0
    fi
    rm -f -- "$target"
  fi
  tmp="$target.part.$$"
  rm -f -- "$tmp"
  curl --fail --location --proto '=https' --tlsv1.2 --retry 3 --retry-all-errors \
    --connect-timeout 20 --max-time 900 --output "$tmp" "$url" \
    || { rm -f -- "$tmp"; die "download failed: $url"; }
  printf '%s  %s\n' "$expected" "$tmp" | sha256sum -c - >/dev/null 2>&1 \
    || { rm -f -- "$tmp"; die "checksum mismatch for $(basename -- "$target")"; }
  chmod 600 -- "$tmp"
  mv -f -- "$tmp" "$target"
}

prepare_runtime() {
  ensure_private_dir "$DATA_ROOT"
  ensure_private_dir "$MODEL_DIR"
  if [[ "${OMAYAP_TEST_MODE:-0}" == 1 ]]; then
    # Tests use a host interpreter and fixture files; no package or model
    # download is performed in this branch.
    require_command python3
    mkdir -p -- "$VENV/bin"
    chmod 700 -- "$VENV"
    cp -- "${OMAYAP_TEST_PYTHON:-$(command -v python3)}" "$VENV/bin/python"
    chmod 700 -- "$VENV/bin/python"
    printf 'test model\n' >"$MODEL"
    printf '{}\n' >"$MODEL_JSON"
    printf 'test model card\n' >"$MODEL_CARD"
    chmod 600 -- "$MODEL" "$MODEL_JSON" "$MODEL_CARD"
    return 0
  fi
  [[ -f "$LOCKFILE" ]] || die "missing dependency lock: $LOCKFILE"
  uv python install 3.13 >/dev/null 2>&1 \
    || die "uv could not provision managed Python 3.13"
  uv python find 3.13 >/dev/null 2>&1 || die "Python 3.13 is unavailable to uv"
  if [[ ! -x "$VENV/bin/python" ]]; then
    uv venv --python 3.13 "$VENV" >/dev/null
  fi
  [[ -x "$VENV/bin/python" ]] || die "failed to create isolated Python 3.13 environment at $VENV"
  uv pip sync --python "$VENV/bin/python" --require-hashes --no-compile "$LOCKFILE"
  download_verified "$MODEL_URL" "$MODEL" "$MODEL_SHA256"
  download_verified "$MODEL_JSON_URL" "$MODEL_JSON" "$MODEL_JSON_SHA256"
  download_verified "$MODEL_CARD_URL" "$MODEL_CARD" "$MODEL_CARD_SHA256"
  "$VENV/bin/python" "$ROOT/worker/worker.py" --model "$MODEL" --config "$MODEL_JSON" --self-test \
    || die "Piper silent synthesis smoke test failed"
}

write_binding_block() {
  local target="$1" tmp="$2"
  if ! awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
    $0 == begin {
      if (dropping) malformed = 1
      dropping = 1
      found = 1
      next
    }
    $0 == end {
      if (!dropping) malformed = 1
      else closed = 1
      dropping = 0
      next
    }
    !dropping { lines[++count] = $0 }
    END {
      if (malformed || (found && !closed)) exit 3
      while (count > 0 && lines[count] ~ /^[[:space:]]*$/) count--
      for (i = 1; i <= count; i++) print lines[i]
    }
  ' "$target" >"$tmp"; then
    rm -f -- "$tmp"
    die "refusing to edit malformed tagged binding block"
  fi
  if [[ -s "$tmp" ]]; then printf '\n' >>"$tmp"; fi
  {
    printf '%s\n' "$BEGIN_MARKER"
    printf '%s\n' "o.bind(\"F10\", \"$OWN_F10_DESCRIPTION\", \"$OWN_F10_COMMAND\")"
    printf '%s\n' "o.bind(\"CTRL + F10\", \"$OWN_OCR_DESCRIPTION\", \"$OWN_OCR_COMMAND\")"
    printf '%s\n' "$END_MARKER"
  } >>"$tmp"
  chmod --reference="$target" "$tmp" 2>/dev/null || chmod 600 -- "$tmp"
  mv -f -- "$tmp" "$target"
}

validate_hyprland() {
  local errors=""
  hyprctl reload >/dev/null 2>&1 || return 1
  errors="$(hyprctl configerrors 2>&1 || true)"
  [[ -z "$errors" ]] && return 0
  if grep -Eiq 'error|invalid|failed|parse' <<<"$errors" \
    && ! grep -Eiq 'no errors|no config errors|config is valid|0 errors' <<<"$errors"; then
    return 1
  fi
  return 0
}

install_binding() {
  local had_file=0 backup="" tmp="" timestamp=""
  mkdir -p -- "$(dirname -- "$BINDINGS")"
  if [[ -e "$BINDINGS" ]]; then
    [[ -f "$BINDINGS" && ! -L "$BINDINGS" ]] || die "refusing unsafe bindings path: $BINDINGS"
    had_file=1
  else
    : >"$BINDINGS"
    chmod 600 -- "$BINDINGS"
  fi
  timestamp="$(date +%Y%m%d%H%M%S)"
  backup="$BINDINGS.bak.$timestamp"
  cp -p -- "$BINDINGS" "$backup"
  tmp="$(mktemp "${BINDINGS}.tmp.XXXXXX")"
  write_binding_block "$BINDINGS" "$tmp"

  if ! validate_hyprland; then
    if ((had_file)); then cp -p -- "$backup" "$BINDINGS"; else rm -f -- "$BINDINGS"; fi
    hyprctl reload >/dev/null 2>&1 || true
    die "Hyprland rejected the OmaYap bindings; the original bindings were restored"
  fi
  echo "OmaYap setup: installed F10 and CTRL+F10 bindings (backup: $backup)"
}

main() {
  [[ -n "${HOME:-}" ]] || die "HOME is not set"
  case "${1:-}" in
    "") ;;
    --help|-h)
      echo "Usage: bin/setup"
      echo "Installs the local Piper runtime and manages the F10 and CTRL+F10 OmaYap bindings."
      echo "OCR uses Omarchy's local capture flow; Codex yaps are opt-in via bin/install-codex-skill."
      return 0
      ;;
    *) die "unknown option: $1" ;;
  esac
  if ! command -v uv >/dev/null 2>&1; then
    echo "OmaYap setup: uv is required. Install it with: omarchy pkg add uv" >&2
    exit 1
  fi
  require_command omarchy
  require_command omarchy-shell
  require_command hyprctl
  if [[ "${OMAYAP_TEST_MODE:-0}" != 1 ]]; then
    require_command curl
    require_command sha256sum
    require_command wl-paste
    require_command wl-copy
    require_command wtype
    require_command pw-play
  fi
  check_binding_conflicts
  prepare_runtime
  install_binding
  ensure_private_dir "${CONFIG_HOME}/omayap-read-aloud"
  local stamp_tmp="$STAMP.tmp.$$"
  printf 'PLUGIN_VERSION=%s\nPYTHON=3.13\nPIPER=1.7.0\nVOICE=%s\nVOICE_SHA256=%s\n' \
    "$PLUGIN_VERSION" "$VOICE" "$MODEL_SHA256" >"$stamp_tmp"
  chmod 600 -- "$stamp_tmp"
  mv -f -- "$stamp_tmp" "$STAMP"
  echo "OmaYap setup: local Piper voice is ready"
}

main "$@"
