#!/usr/bin/env python3
"""Send a privacy-safe Codex alert to the running OmaYap service."""

from __future__ import annotations

import errno
import os
import re
import select
import secrets
import stat
import subprocess
import sys
import time
from pathlib import Path


MAX_CHARS = 20_000
MAX_BYTES = 80_004
WRITE_TIMEOUT = 5.0
EXIT_USAGE = 64
EXIT_UNAVAILABLE = 69
EXIT_BUSY = 75
EXIT_LIMIT = 76
EXIT_INPUT = 77
TOKEN_RE = re.compile(r"^[0-9a-f]{32}$")

EVENT_TEXT = {
    "complete": "Codex finished the task.",
    "permission": "Codex needs your permission.",
    "attention": "Codex needs your attention.",
    "failed": "Codex could not finish the task.",
}


def _private_directory(path: Path, mode: int) -> bool:
    try:
        info = os.lstat(path)
    except OSError:
        return False
    return (
        stat.S_ISDIR(info.st_mode)
        and info.st_uid == os.getuid()
        and stat.S_IMODE(info.st_mode) == mode
    )


def _runtime_base() -> Path | None:
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime or not runtime.startswith("/") or "\x00" in runtime or "\n" in runtime:
        return None
    runtime_path = Path(runtime)
    if not _private_directory(runtime_path, 0o700):
        return None
    base = runtime_path / "omayap-read-aloud"
    try:
        if base.exists() and not _private_directory(base, 0o700):
            return None
        if not base.exists():
            base.mkdir(mode=0o700)
        os.chmod(base, 0o700)
    except OSError:
        return None
    return base


def _read_custom() -> tuple[bytes | None, int]:
    try:
        raw = sys.stdin.buffer.read(MAX_BYTES + 1)
    except (OSError, ValueError):
        return None, EXIT_INPUT
    if len(raw) > MAX_BYTES:
        return None, EXIT_LIMIT
    try:
        text = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        return None, EXIT_INPUT
    if not text.strip() or len(text) > MAX_CHARS:
        return None, EXIT_INPUT if not text.strip() else EXIT_LIMIT
    return raw, 0


def _open_fifo(path: Path) -> int | None:
    try:
        info = os.lstat(path)
        if not (
            stat.S_ISFIFO(info.st_mode)
            and info.st_uid == os.getuid()
            and stat.S_IMODE(info.st_mode) == 0o600
        ):
            return None
        flags = os.O_WRONLY | os.O_NONBLOCK
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        return os.open(path, flags)
    except OSError as error:
        if error.errno in (errno.ENOENT, errno.ENXIO, errno.ELOOP):
            return None
        return None


def _write_fifo(path: Path, payload: bytes) -> bool:
    deadline = time.monotonic() + WRITE_TIMEOUT
    descriptor = None
    try:
        while descriptor is None and time.monotonic() < deadline:
            descriptor = _open_fifo(path)
            if descriptor is not None:
                break
            time.sleep(0.01)
        if descriptor is None:
            return False
        offset = 0
        poller = select.poll()
        poller.register(descriptor, select.POLLOUT | select.POLLERR | select.POLLHUP)
        while offset < len(payload):
            remaining = max(0.0, deadline - time.monotonic())
            if remaining == 0 or not poller.poll(int(remaining * 1000)):
                return False
            try:
                offset += os.write(descriptor, payload[offset:])
            except (BrokenPipeError, OSError):
                return False
        return True
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass


def _invoke_service(token: str) -> str:
    try:
        response = subprocess.run(
            ["omarchy-shell", "omayap.read-aloud", "speakRequest", token],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=WRITE_TIMEOUT,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return "unavailable"
    result = response.stdout.strip()
    return result if result in {"ok", "busy", "invalid", "unavailable"} else "unavailable"


def send(event: str) -> int:
    if event == "custom":
        payload, error = _read_custom()
        if payload is None:
            return error
    elif event in EVENT_TEXT:
        payload = EVENT_TEXT[event].encode("utf-8")
    else:
        return EXIT_USAGE

    base = _runtime_base()
    if base is None:
        return EXIT_UNAVAILABLE
    token = secrets.token_hex(16)
    if not TOKEN_RE.fullmatch(token):
        return EXIT_UNAVAILABLE
    path = base / f"request-{token}.fifo"
    try:
        os.mkfifo(path, 0o600)
        os.chmod(path, 0o600)
    except OSError:
        return EXIT_UNAVAILABLE
    sent = False
    try:
        response = _invoke_service(token)
        if response == "busy":
            return EXIT_BUSY
        if response != "ok":
            return EXIT_UNAVAILABLE
        sent = _write_fifo(path, payload)
        return 0 if sent else EXIT_UNAVAILABLE
    finally:
        # The consumer unlinks its verified FIFO after reading. Do not unlink
        # after a successful write: the reader may still be between lstat and
        # open, and an early publisher cleanup would lose the alert.
        if not sent:
            try:
                info = os.lstat(path)
                if stat.S_ISFIFO(info.st_mode) and info.st_uid == os.getuid():
                    path.unlink()
            except OSError:
                pass


def main() -> int:
    if len(sys.argv) != 2:
        return EXIT_USAGE
    try:
        return send(sys.argv[1])
    except Exception:
        return EXIT_UNAVAILABLE


if __name__ == "__main__":
    raise SystemExit(main())
