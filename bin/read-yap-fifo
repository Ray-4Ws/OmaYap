#!/usr/bin/env python3
"""Read one validated OmaYap Codex-alert FIFO and remove it safely."""

from __future__ import annotations

import os
import re
import select
import stat
import sys
import time
from pathlib import Path


MAX_BYTES = 80_004
READ_TIMEOUT = 5.0
EXIT_INVALID = 64
EXIT_TIMEOUT = 65
EXIT_INVALID_UTF8 = 66
TOKEN_RE = re.compile(r"^[0-9a-f]{32}$")


def _private_directory(path: Path, mode: int) -> bool:
    try:
        info = os.lstat(path)
    except OSError:
        return False
    return (
        stat.S_ISDIR(info.st_mode)
        and info.st_uid == os.getuid()
        and stat.S_IMODE(info.st_mode) == mode
    )


def _fifo_path(token: str) -> Path | None:
    if not TOKEN_RE.fullmatch(token):
        return None
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime or not runtime.startswith("/") or "\x00" in runtime or "\n" in runtime:
        return None
    runtime_path = Path(runtime)
    base = runtime_path / "omayap-read-aloud"
    if not _private_directory(runtime_path, 0o700) or not _private_directory(base, 0o700):
        return None
    return base / f"request-{token}.fifo"


def _unlink_if_same(path: Path, descriptor: int) -> None:
    try:
        expected = os.fstat(descriptor)
        current = os.lstat(path)
        if (
            current.st_dev == expected.st_dev
            and current.st_ino == expected.st_ino
            and stat.S_ISFIFO(current.st_mode)
            and current.st_uid == os.getuid()
        ):
            path.unlink()
    except OSError:
        pass


def read_fifo(token: str) -> int:
    path = _fifo_path(token)
    if path is None:
        return EXIT_INVALID
    try:
        info = os.lstat(path)
        if not (
            stat.S_ISFIFO(info.st_mode)
            and info.st_uid == os.getuid()
            and stat.S_IMODE(info.st_mode) == 0o600
        ):
            return EXIT_INVALID
        flags = os.O_RDONLY | os.O_NONBLOCK
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(path, flags)
    except OSError:
        return EXIT_INVALID

    try:
        opened = os.fstat(descriptor)
        if not (
            stat.S_ISFIFO(opened.st_mode)
            and opened.st_uid == os.getuid()
            and stat.S_IMODE(opened.st_mode) == 0o600
        ):
            return EXIT_INVALID
        poller = select.poll()
        poller.register(descriptor, select.POLLIN | select.POLLHUP | select.POLLERR)
        output = bytearray()
        saw_data = False
        deadline = time.monotonic() + READ_TIMEOUT
        while True:
            remaining = max(0.0, deadline - time.monotonic())
            if remaining == 0:
                return EXIT_TIMEOUT
            events = poller.poll(int(remaining * 1000))
            if not events:
                return EXIT_TIMEOUT
            chunk = os.read(descriptor, min(16 * 1024, MAX_BYTES + 1 - len(output)))
            if not chunk:
                # A read-only FIFO reports HUP before its writer has opened
                # the other end on Linux. Ignore that pre-writer state until
                # the bounded deadline; after data has arrived, HUP means the
                # publisher closed its end and the message is complete.
                if saw_data:
                    break
                time.sleep(0.01)
                continue
            output.extend(chunk)
            saw_data = True
            if len(output) > MAX_BYTES:
                # Emit only fixed bytes so bounded_capture returns its reserved
                # overflow status without exposing the alert contents.
                sys.stdout.buffer.write(b"x" * (MAX_BYTES + 1))
                sys.stdout.buffer.flush()
                return 0
        try:
            output.decode("utf-8", errors="strict")
        except UnicodeDecodeError:
            return EXIT_INVALID_UTF8
        sys.stdout.buffer.write(output)
        sys.stdout.buffer.flush()
        return 0
    except (OSError, ValueError):
        return EXIT_INVALID
    finally:
        _unlink_if_same(path, descriptor)
        try:
            os.close(descriptor)
        except OSError:
            pass


def main() -> int:
    if len(sys.argv) != 2:
        return EXIT_INVALID
    try:
        return read_fifo(sys.argv[1])
    except Exception:
        return EXIT_INVALID


if __name__ == "__main__":
    raise SystemExit(main())
